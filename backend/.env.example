# Touch Grass AI - Environment Configuration Example

# Backend Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Inference Configuration
# Options: "ollama" (local), "hosted" (OpenAI-compatible / OpenRouter / Groq / HuggingFace), or "fallback" (deterministic only)
AI_INFERENCE_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2:2b

# Hosted Inference Settings (used if AI_INFERENCE_PROVIDER=hosted)
HOSTED_API_BASE_URL=https://openrouter.ai/api/v1
HOSTED_API_KEY=
HOSTED_MODEL=google/gemma-2-9b-it:free

# Places Data Mode ("osm" for genuine OpenStreetMap Nominatim/Overpass queries, or "local" for genuine verified curated fallback directory)
PLACES_MODE=osm
